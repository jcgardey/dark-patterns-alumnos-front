{
  "manifest_version": 3,
  "name": "DP_extension",
  "version": "1.2",
  "description": "Detector de ciertos patrones oscuros (Dark Patterns)",

  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://dark-patterns-extension.lifia.info.unlp.edu.ar/*",
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "menu/pop-up.html",
    "default_icon": "menu/imagenes/icono.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "globals.js",
        "counter.js",
        "XPathInterpreter.js",
        "page_segmentation/common.js",
        "page_segmentation/block_segment.js",
        "hiddenCosts.js",
        "fakeUrgency.js",
        "scarcity.js",
        "preselection.js",
        "confirmshaming.js",
        "misdirection-script.js",
        "extension.js"
      ]
    }
  ],
  "background": {
    "scripts": ["serviceworker.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-patterns-extension@lifia.info.unlp.edu.ar",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": []
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu/imagenes/icono.png",
        "fuentes/SpaceMono-Regular.ttf",
        "fuentes/SpaceMono-Bold.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

